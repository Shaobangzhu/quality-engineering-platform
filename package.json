{
  "name": "quality-engineering-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4 <23",
    "npm": ">=10.9.0"
  },
  "bin": {
    "qe": "dist/cli.js"
  },
  "imports": {
    "#package": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings 0",
    "pretest": "npm run build --silent",
    "test": "node test/cli.test.js",
    "preqe": "npm run build --silent",
    "qe": "node dist/cli.js"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "eslint": "10.15.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0"
  }
}
